  "links": {
    "html": "\n\n<div class=\"div-management\">\n</div>\n<div class=\"div-management\">\n<div class=\"wrapper\">\n<h1 class=\"topic\">相关链接</h1>\n<div class=\"l div-management-l\" id=\"div-management-l\">\n<p style=\"font-size: 20px; text-align: left;\"><span style=\"font-size: 20px; font-family: 'trebuchet ms', geneva; color: #333399;\"><strong><a href=\"http://www.matsuda-sangyo.co.jp/en/index.html\" rel=\"noopener noreferrer\" target=\"_blank\"><span style=\"color: #333399;\">Matsuda Sangyo Co., Ltd.</span></a></strong></span></p> </div>\n<div class=\"r div-management-r\" id=\"div-management-r\">\n<p><span style=\"color: #ff6600; font-family: georgia, palatino; font-size: 19px;\"> </span></p> </div><div class=\"clear\"></div>\n<p> </p>\n<div class=\"r2 div-management-r2\" id=\"div-management-r2\">\n</div>\n<div class=\"l2 div-management-l2\" id=\"div-management-l2\">\n</div>\n<div class=\"clear\"></div>\n</div>\n</div>\n<div class=\"div-management2\" id=\"div-management2\">\n<div class=\"wrapper\">\n<div class=\"d\">\n<h2>Management Message</h2>\n<p>Matsuda Sangyo (Thailand) Co., Ltd. is committed to responsible precious metal processing and recycling with advanced environmental technologies. Our operations focus on sustainability, safety, and continuous improvement in all aspects of metal refining and resource recovery.</p>\n<p>We maintain strict quality control standards and environmental compliance to ensure both product excellence and environmental protection for our communities and stakeholders.</p>\n</div>\n</div>\n<img alt=\"\" class=\"bg-management2\" id=\"bg-management2\" loading=\"lazy\" src=\"/legacy/images/bg-management2.png\"/></div>\n"
  },
  "business": {
    "html": "\n\n<div class=\"div-business1\">\n<div class=\"wrapper\">\n<img alt=\"\" class=\"img-business1\" id=\"img-business1\" loading=\"lazy\" src=\"/legacy/images/img-business1_en.png\"/>\n</div>\n</div>\n<div class=\"wrapper\">\n<p><strong>我们的业务</strong></p>\n<p>Matsuda Sangyo (Thailand) Co., Ltd. provides efficient logistics solutions for precious metal processing and recycling. Our comprehensive business operations include:</p>\n<ul>\n<li>GPS-equipped transportation fleet (4-10 wheels closed cargo trucks) for safe, trackable delivery</li>\n<li>Advanced precious metal refining technology with environmental friendly know-how</li>\n<li>Green Industry certified operations at Ayutthaya Head Office and Chonburi Branch</li>\n<li>Carbon credit initiatives for sustainable business practices</li>\n</ul>\n<p>We serve customers throughout Thailand with reliable waste and scrap transportation services, supported by an efficient logistics system and experienced team dedicated to excellence in resource recovery.</p>\n</div>\n"
  },
  "awards": {
