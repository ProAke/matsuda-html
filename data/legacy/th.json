  "home": {
    "introduction": "<div class=\"div-index2\">\n<div class=\"wrapper2\" style=\"padding-top:20px;padding-buttom:20px;\">\n<div class=\"l div-index2-l\" id=\"div-index2-l\">\n<h2 class=\"h-f3\">เพื่อโลกที่สวยงามและความมั่งคั่งสมบูรณ์</h2>\n</div>\n<div class=\"r div-index2-r\" id=\"div-index2-r\">\n<p style=\"font-size: 22px; color: #231f20; text-align: center;\"><span style=\"font-family: 'trebuchet ms', geneva; font-size: 16px; color: #ffffff;\">มัตซึดะ ซังเกียว (ประเทศไทย)</span></p>\n<p style=\"font-size: 22px; color: #231f20; text-align: center;\"><span style=\"font-family: 'trebuchet ms', geneva; font-size: 16px; color: #ffffff;\">ประกอบธุรกิจประเภทต่างๆ ที่เกี่ยวข้องกับโลหะมีค่า</span></p>\n<p style=\"font-size: 22px; color: #231f20; text-align: center;\"><span style=\"font-family: 'trebuchet ms', geneva; font-size: 16px; color: #ffffff;\">ดำเนินธุรกิจที่เกี่ยวข้องกับโลหะมีค่าต่างๆ</span></p> </div>\n<div class=\"r2 div-index2-r2\" id=\"div-index2-r2\">\n<p style=\"font-size: 22px; color: #231f20;\"><span style=\"color: #ffffff; font-family: 'trebuchet ms', geneva; font-size: 16px;\">- สกัดและรวบรวมโลหะมีค่า </span></p>\n<p style=\"font-size: 22px; color: #231f20;\"><span style=\"color: #ffffff; font-family: 'trebuchet ms', geneva; font-size: 16px;\">- นำเข้าและจัดจำหน่ายวัสดุภัณฑ์โลหะมีค่า</span></p> </div>\n</div>\n<div class=\"clear\"></div>\n</div>",
    "diagram": "<div id=\"div-index3\">\n<div class=\"div-index3-1\">\n<div class=\"wrapper w-index3-1\">\n<img alt=\"\" class=\"line-index3-1\" id=\"line-index3-1\" loading=\"lazy\" src=\"/legacy/images/line-index3-1.png\"/>\n</div>\n<div class=\"wrapper wrapper-hidden w-index3-2\">\n<img alt=\"\" class=\"img-index3-1\" id=\"img-index3-1\" loading=\"lazy\" src=\"/legacy/images/img-index3-1_en.png\"/>\n</div>\n</div>\n<div class=\"div-index3-2\">\n<div class=\"wrapper wrapper-hidden\">\n<img alt=\"\" class=\"img-index3-2\" id=\"img-index3-2\" loading=\"lazy\" src=\"/legacy/images/img-index3-2.png\"/>\n</div>\n</div>\n</div>",
